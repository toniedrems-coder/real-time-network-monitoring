# Copy to infrastructure/.env and fill in. Never commit the real .env.
# Required by infrastructure/docker-compose.yml
POSTGRES_PASSWORD=change-me-to-a-long-random-password
PUBLIC_ORIGIN=http://localhost:8080
# Your OIDC identity provider (the compose stack does not include the dev token issuer)
AUTHENTICATION_AUTHORITY=https://your-idp.example.com/
AUTHENTICATION_AUDIENCE=network-monitoring-api
AUTHENTICATION_SWAGGER_TOKEN_URL=https://your-idp.example.com/oauth2/token

# Optional
# FRONTEND_PORT=8080
# NOTIFICATIONS_EMAIL_SMTP_HOST=
# NOTIFICATIONS_EMAIL_FROM=
# NOTIFICATIONS_SMS_ACCOUNT_SID=
# NOTIFICATIONS_SMS_AUTH_TOKEN=
# NOTIFICATIONS_SMS_FROM=
# DOCKER_API_BASE_URL=
