{
  "title": "Network Monitor - Overview",
  "uid": "network-monitor-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Probe Latency (p95, ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(network_monitor_probe_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "id": 2,
      "title": "Probe Results (reachable vs unreachable)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(network_monitor_probe_result_total[5m])) by (reachable)",
          "legendFormat": "reachable={{reachable}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Anomalies Detected (by type / method)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(network_monitor_anomaly_detected_total[5m])) by (type, detectionMethod)",
          "legendFormat": "{{type}} ({{detectionMethod}})"
        }
      ]
    },
    {
      "id": 4,
      "title": "Kafka Produced vs Consumed (by topic)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(network_monitor_kafka_produced_total[5m])) by (topic)",
          "legendFormat": "produced:{{topic}}"
        },
        {
          "expr": "sum(rate(network_monitor_kafka_consumed_total[5m])) by (topic)",
          "legendFormat": "consumed:{{topic}}"
        }
      ]
    }
  ]
}
